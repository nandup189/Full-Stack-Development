<!DOCTYPE html>
<html>
<head>
<title>Fruit World</title>
<style>
body {
    font-family: Arial;
    background: #f0f0f0;
}
.navbar {
    background: green;
    color: white;
    padding: 15px;
    text-align: center;
}
.menu {
    width: 200px;
    float: left;
    background: white;
    height: 100vh;
    padding: 10px;
    box-shadow: 2px 0 5px gray;
}
.menu h3 {
    margin-bottom: 10px;
}
.menu button {
    display: block;
    width: 100%;
    padding: 10px;
    margin: 5px 0;
    border: none;
    background: #e0e0e0;
    cursor: pointer;
    text-align: left;
}
.menu button:hover {
    background: orange;
    color: white;
}
.details {
    margin-left: 220px;
    padding: 20px;
}
.details img {
    width: 200px;
    height: 200px;
}
</style>
<script>
function showFruit(name, desc, img) {
    document.getElementById("name").innerHTML = name;
    document.getElementById("desc").innerHTML = desc;
    document.getElementById("img").src = img;
}
</script>
</head>
<body>
<div class="navbar">
    <h2>🍎 Fruit World</h2>
<h3>25K65A1207<h3>
</div>
<div class="menu">
    <h3>Fruits</h3>
    <button onclick="showFruit('Apple','Apple is rich in fiber and good for heart health. It helps in digestion and keeps you fit.','image/apple.jpg')">Apple</button>
    <button onclick="showFruit('Banana','Banana gives instant energy. It is rich in potassium and good for muscles.','image/banana.jpg')">Banana</button>
    <button onclick="showFruit('Mango','Mango is called the king of fruits. It is sweet, tasty and rich in vitamins.','image/mango.jpg')">Mango</button>
    <button onclick="showFruit('Orange','Orange is rich in Vitamin C. It improves immunity and keeps skin healthy.','image/orange.jpg')">Orange</button>
    <button onclick="showFruit('Grapes','Grapes are good for heart health. They contain antioxidants and boost immunity.','image/grape.jpg')">Grapes</button>
    <button onclick="showFruit('Pineapple','Pineapple helps in digestion. It contains enzymes and is very refreshing.','image/pineapple.jpg')">Pineapple</button>
    <button onclick="showFruit('Strawberry','Strawberries are rich in antioxidants and good for skin health.','image/strawberry.jpg')">Strawberry</button>
    <button onclick="showFruit('Watermelon','Watermelon keeps body hydrated. It contains lots of water and is good in summer.','image/watermelon.jpg')">Watermelon</button>
    <button onclick="showFruit('Papaya','Papaya improves digestion. It is rich in vitamins and good for stomach health.','image/papaya.jpg')">Papaya</button>
    <button onclick="showFruit('Guava','Guava is very rich in Vitamin C. It helps boost immunity and digestion.','image/guava.jpg')">Guava</button>
</div>
<!-- RIGHT DETAILS -->
<div class="details">
    <h2 id="name">Select a Fruit</h2>
    <img id="img" src="image/select.jpg">
    <p id="desc">Click any fruit from left menu</p>
</div>
</body>
</html>
